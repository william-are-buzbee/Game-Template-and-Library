{
  "name": "@wb/rootshock",
  "private": true,
  "version": "0.0.0",
  "description": "A first-person game set in Lowfield Station, a facility deep under a field.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').cpSync('archive','dist/archive',{recursive:true})\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@wb/core": "*",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "card": {
    "query": "?shot=lobby"
  }
}

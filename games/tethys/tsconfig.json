{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "skipLibCheck": true,
    "moduleDetection": "legacy",
    "allowImportingTsExtensions": true
  },
  "include": ["src/*.js", "types/*.d.ts"]
}
